rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /appointments/{appointment} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && resource.data.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Each user can read their own admin doc to know if they are admin.
    // Only admins can add or remove other admins.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}